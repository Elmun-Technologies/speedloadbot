# Telegram Bot
BOT_TOKEN=

# Database & Redis
DATABASE_URL=postgresql://user:password@postgres:5432/speedload
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# AI Services (optional — Trend Radar AI research & Whisper transcription)
OPENAI_API_KEY=

# Admin API / Dashboard
# ⚠️ Set strong values in production — there are no safe defaults!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
JWT_SECRET=change_me_to_a_long_random_string
# Comma-separated origins allowed to call the admin API from a browser
ADMIN_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# API Server
API_HOST=0.0.0.0
API_PORT=8000
